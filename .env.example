# Copy to .env and adjust as needed. docker-compose reads this file automatically.

# --- Database ---
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=joga10
MYSQL_USER=joga10
MYSQL_PASSWORD=joga10
DB_PORT=3306

# --- Backend ---
# IMPORTANT: use a long random value in production.
SECRET_KEY=please-change-this-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=*
BACKEND_PORT=8000

# --- Frontend (nginx) ---
FRONTEND_PORT=8080
