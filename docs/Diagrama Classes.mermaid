erDiagram
    users ||--o{ group_memberships : "é membro"
    grupos ||--o{ group_memberships : "possui"
    users ||--o{ grupos : "cria (created_by)"
    users ||--o{ invites : "cria (created_by)"
    grupos ||--o{ invites : "possui"
    grupos ||--o{ players : "possui"
    players ||--o| player_photos : "foto (opcional)"
    grupos ||--o{ events : "possui"
    events ||--o{ teams : "possui"
    events ||--o{ matches : "possui"
    events ||--o{ match_stats : "por evento"
    teams ||--o{ team_players : "contém"
    players ||--o{ team_players : "participa"
    teams ||--o{ matches : "team_a"
    teams ||--o{ matches : "team_b"
    matches ||--o{ match_stats : "possui"
    players ||--o{ match_stats : "registra"
    teams |o--o{ match_stats : "por time (opcional)"

    users {
        int id PK
        string name
        string email UK
        string password_hash
        datetime created_at
    }

    grupos {
        int id PK
        string name
        text description
        int created_by FK
        datetime created_at
        float min_skill "nota mínima (padrão 0)"
        float max_skill "nota máxima (padrão 10)"
    }

    group_memberships {
        int id PK
        int group_id FK
        int user_id FK
        enum role "admin|moderator|member"
        datetime joined_at
    }

    invites {
        int id PK
        int group_id FK
        string token UK
        enum role "admin|moderator|member"
        int created_by FK
        int max_uses "null = ilimitado"
        int uses
        datetime expires_at
        bool active
        datetime created_at
    }

    players {
        int id PK
        int group_id FK
        string name
        string position
        float skill "dentro da faixa do grupo"
        bool active
        string photo_key UK "URL da foto (aleatória)"
        datetime created_at
    }

    player_photos {
        int player_id PK, FK
        string content_type
        blob data "JPEG quadrado 512px"
        datetime updated_at
    }

    events {
        int id PK
        int group_id FK
        string title
        date date
        string draw_mode "random|heuristic|optimal"
        bool draw_proven
        bool use_substitutes
        int wins_to_leave "0 = sem limite"
        datetime created_at
    }

    teams {
        int id PK
        int event_id FK
        string name
        string color
        bool active "false = arquivado (já jogou)"
        datetime created_at
    }

    team_players {
        int id PK
        int team_id FK
        int player_id FK
    }

    matches {
        int id PK
        int event_id FK
        int team_a_id FK
        int team_b_id FK
        int score_a
        int score_b
        string status "in_progress|finished"
        int sequence
        string staying "a|b|none|both"
        datetime played_at "fim da partida"
        datetime created_at "início"
    }

    match_stats {
        int id PK
        int match_id FK
        int event_id FK
        int player_id FK
        int team_id FK
        int goals
        int assists
    }
